# With Supabase transaction pooling, add pgbouncer=true, connection_limit=1 and pool_timeout=30.
DATABASE_URL="postgresql://postgres:password@localhost:5432/educare?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/educare?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
PAYSTACK_WEBHOOK_SECRET="replace-with-paystack-secret"
# Use test keys during development. A public HTTPS webhook is required for live payments.

RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Educare Portal <noreply@example.com>"

CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

